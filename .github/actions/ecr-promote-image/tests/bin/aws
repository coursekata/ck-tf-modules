#!/usr/bin/env bash
set -euo pipefail

repository=""
while [ "$#" -gt 0 ]; do
  if [ "$1" = "--repository-name" ]; then
    repository="$2"
    shift 2
  else
    shift
  fi
done

not_found() {
  echo "An error occurred (ImageNotFoundException)" >&2
  exit 254
}

if [ "$repository" = "release" ]; then
  case "$TEST_SCENARIO" in
    released)
      echo "sha256:released"
      ;;
    aws-error)
      echo "An error occurred (AccessDeniedException)" >&2
      exit 254
      ;;
    success|mismatch)
      if [ -f "$TEST_STATE/promoted" ]; then
        if [ "$TEST_SCENARIO" = mismatch ]; then
          echo "sha256:different"
        else
          echo "sha256:candidate"
        fi
      else
        not_found
      fi
      ;;
    timeout)
      not_found
      ;;
  esac
  exit 0
fi

if [ "$repository" = "candidate" ]; then
  case "$TEST_SCENARIO" in
    success|mismatch)
      attempts=0
      if [ -f "$TEST_STATE/candidate-attempts" ]; then
        attempts=$(cat "$TEST_STATE/candidate-attempts")
      fi
      attempts=$((attempts + 1))
      echo "$attempts" > "$TEST_STATE/candidate-attempts"
      if [ "$attempts" -eq 1 ]; then
        not_found
      fi
      echo "sha256:candidate"
      ;;
    *)
      not_found
      ;;
  esac
  exit 0
fi

echo "unexpected repository: $repository" >&2
exit 2
